{
  "name": "@protectqa/tcl-sdk",
  "version": "0.1.1",
  "description": "Public TCL SDK for apps — wraps tcl-core validate() and Agent Studio adapters.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/protectqa/tcl.git",
    "directory": "packages/tcl-sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@protectqa/tcl-core": "^0.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@protectqa/tcl-core": "file:../tcl-core",
    "typescript": "^5.6.3"
  },
  "peerDependencies": {
    "@protectqa/tcl-core": ">=0.2.1"
  }
}
