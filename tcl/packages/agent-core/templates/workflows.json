      { "key": "fix", "label": "Fix" },
      { "key": "regression", "label": "Regression" },
      { "key": "done", "label": "Done" }
    ],
    "defaultTasks": [
      { "title": "Reproduce reported bug locally", "columnKey": "reproduce", "taskType": "BUG" },
