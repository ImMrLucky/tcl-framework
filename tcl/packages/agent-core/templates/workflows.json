[
  {
    "key": "bmad_full_sdlc",
    "name": "BMAD — Full SDLC",
    "description": "Build → Measure → Analyze → Decide. Full SDLC pipeline with explicit spec, design, build, QA, and security gates.",
    "recommendedRoles": [
      "agent_manager",
      "business_analyst",
      "product_owner",
      "ux_designer",
      "software_architect",
      "senior_software_engineer",
      "qa_engineer",
      "security_reviewer"
    ],
    "defaultBoardColumns": [
      { "key": "intake", "label": "Intake" },
      { "key": "spec", "label": "Spec" },
      { "key": "design", "label": "Design" },
      { "key": "build", "label": "Build" },
      { "key": "qa", "label": "QA" },
      { "key": "review", "label": "Review" },
      { "key": "done", "label": "Done" }
    ],
    "defaultTasks": [
      { "title": "Capture problem statement", "columnKey": "intake", "taskType": "RESEARCH" },
      { "title": "Draft acceptance criteria", "columnKey": "spec", "taskType": "SPEC" },
      { "title": "Design technical approach", "columnKey": "design", "taskType": "SPEC" },
      { "title": "Implement vertical slice", "columnKey": "build", "taskType": "STORY" },
      { "title": "Author + run test plan", "columnKey": "qa", "taskType": "REVIEW" }
    ],
    "reviewGates": [
      { "afterColumnKey": "spec", "gateType": "SPEC_REVIEW", "requiredRole": "MANAGER" },
      { "afterColumnKey": "build", "gateType": "CODE_REVIEW", "requiredRole": "MANAGER" },
      { "afterColumnKey": "qa", "gateType": "QA_REVIEW", "requiredRole": "MANAGER" },
      { "afterColumnKey": "review", "gateType": "SECURITY_REVIEW", "requiredRole": "ADMIN" }
    ]
  },
  {
