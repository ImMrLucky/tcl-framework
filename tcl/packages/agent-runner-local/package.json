    "start": "node dist/cli.js start",
    "doctor": "node dist/cli.js doctor"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "~5.2.2"
  }
