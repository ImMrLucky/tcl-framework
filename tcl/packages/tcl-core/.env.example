# Supabase (server / worker only for SERVICE_ROLE — never bundle into Angular)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (optional - for LLM adapter features)
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-4.1-mini

# Spectral Service (optional - for coherence scoring)
TCL_SPECTRAL_URL=http://localhost:8080

# Server Configuration
PORT=8787
NODE_ENV=development
ENGINE_VERSION=0.2.0
